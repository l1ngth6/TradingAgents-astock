# 复制为项目根目录的 .env 后重启服务：
#   cp .env.example2 .env
#   APP_UID="$(id -u)" APP_GID="$(id -g)" docker compose run --build --rm tradingagents
# Web 模式则运行：
#   APP_UID="$(id -u)" APP_GID="$(id -g)" docker compose up --build web
# 或：streamlit run web/app.py

# Linux Docker 用户映射。命令行传入 APP_UID="$(id -u)" APP_GID="$(id -g)"
# 会覆盖这里的默认值，避免宿主机 ./reports 由 root 或陌生 UID 持有。
APP_UID=1000
APP_GID=1000

# 自定义 OpenAI 兼容端点及凭据
TRADINGAGENTS_LLM_PROVIDER=openai_compatible
TRADINGAGENTS_LLM_BACKEND_URL=http://192.168.2.221:8080/v1
OPENAI_COMPATIBLE_API_KEY=请替换为你的API_KEY

# 所有模型均通过 OpenAI Responses API（/v1/responses），不使用 Chat Completions
TRADINGAGENTS_OPENAI_COMPATIBLE_USE_RESPONSES_API=true

# Quick 默认：不参与多空/风险讨论的分析、质量检查、交易计划等工作
TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.6-luna

# Deep：Research Manager / Portfolio Manager
TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.6-sol

# 所有模型统一使用 high thinking；兼容端点会收到 reasoning_effort=high
TRADINGAGENTS_OPENAI_REASONING_EFFORT=high

# 讨论角色单独改用 deepseek-v4-flash：Bull/Bear 多空辩论 + 风险三方辩论。
# Research Manager / Portfolio Manager 属于 Deep 档，仍使用上面的 gpt-5.6-sol。
TRADINGAGENTS_ROLE_LLMS='{"bull":{"model":"deepseek-v4-flash","thinking_level":"high"},"bear":{"model":"deepseek-v4-flash","thinking_level":"high"},"risk_aggressive":{"model":"deepseek-v4-flash","thinking_level":"high"},"risk_neutral":{"model":"deepseek-v4-flash","thinking_level":"high"},"risk_conservative":{"model":"deepseek-v4-flash","thinking_level":"high"}}'

# 可选：适当放宽报告输出上限
TRADINGAGENTS_MAX_TOKENS=16000
